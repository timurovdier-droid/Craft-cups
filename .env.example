# Локально Prisma CLI работает с файлом. На Vercel это значение нужно только для prisma generate.
DATABASE_URL="file:./dev.db"

# Turso (обязательно на Vercel)
TURSO_DATABASE_URL="libsql://YOUR-DB.turso.io"
TURSO_AUTH_TOKEN=""

AUTH_SECRET="замените-на-длинную-случайную-строку"
AUTH_TRUST_HOST="true"

# Пользователи создаются сами при первом входе, если таблица пустая
USER1_NAME="Дониёр"
USER1_LOGIN="doniyor"
USER1_PASSWORD="cups111"

USER2_NAME="Ильёс"
USER2_LOGIN="ilyos"
USER2_PASSWORD="cups222"

USER3_NAME="Исобу"
USER3_LOGIN="isobu"
USER3_PASSWORD="cups333"

# На Vercel: Storage → Blob → подключить. Токен подставится сам как BLOB_READ_WRITE_TOKEN
# BLOB_READ_WRITE_TOKEN=""
